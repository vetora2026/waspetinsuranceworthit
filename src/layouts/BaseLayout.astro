---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalURL = Astro.url;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5806594895991752" crossorigin="anonymous"></script>
  </head>
  <body class="min-h-screen flex flex-col" style="background:#FAFAF7; color:#1A1A1A; font-family:system-ui,-apple-system,sans-serif; background-image:url(&quot;data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg opacity='0.035' fill='%239CA3AF'%3E%3Cellipse cx='13' cy='12' rx='2.5' ry='3'/%3E%3Cellipse cx='20' cy='10' rx='2.5' ry='3'/%3E%3Cellipse cx='27' cy='12' rx='2.5' ry='3'/%3E%3Cellipse cx='10' cy='17' rx='2.5' ry='3'/%3E%3Cpath d='M20 17C16 17 13 20 13 24C13 28 15.5 31 20 31C24.5 31 27 28 27 24C27 20 24 17 20 17Z'/%3E%3C/g%3E%3C/svg%3E&quot;); background-size:40px 40px;">

    <!-- Sticky header -->
    <header class="sticky top-0 z-50 border-b border-gray-200 bg-white/95 backdrop-blur-sm">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
        <a href="/" class="font-bold text-base sm:text-lg hover:opacity-80 transition-opacity" style="color:#1B6B6D;">
          WasPetInsuranceWorthIt.com
        </a>

        <!-- Desktop nav -->
        <nav class="hidden sm:flex items-center gap-6 text-sm font-medium text-gray-600">
          <a href="/" class="hover:text-gray-900 transition-colors">Calculator</a>
          <a href="/about" class="hover:text-gray-900 transition-colors">Methodology</a>
          <a href="/privacy" class="hover:text-gray-900 transition-colors">Privacy</a>
        </nav>

        <!-- Mobile nav toggle -->
        <button
          id="mobile-menu-btn"
          class="sm:hidden p-2 rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-100"
          aria-label="Toggle menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <!-- Mobile nav panel -->
      <div id="mobile-menu" class="hidden sm:hidden border-t border-gray-100 bg-white px-4 py-3">
        <nav class="flex flex-col gap-3 text-sm font-medium text-gray-700">
          <a href="/" class="hover:text-gray-900">Calculator</a>
          <a href="/about" class="hover:text-gray-900">Methodology</a>
          <a href="/privacy" class="hover:text-gray-900">Privacy</a>
        </nav>
      </div>
    </header>

    <main class="flex-1 px-4 sm:px-6 py-8 max-w-4xl mx-auto w-full">
      <slot />
    </main>

    <footer class="border-t border-gray-200 py-6 px-4 sm:px-6 text-sm text-gray-500 mt-12">
      <div class="max-w-4xl mx-auto flex flex-col sm:flex-row justify-between gap-3">
        <span>&copy; 2026
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="inline mx-1 opacity-50" aria-hidden="true">
            <ellipse cx="7" cy="5.5" rx="2.5" ry="3"/>
            <ellipse cx="12" cy="4" rx="2.5" ry="3"/>
            <ellipse cx="17" cy="5.5" rx="2.5" ry="3"/>
            <ellipse cx="4.5" cy="10" rx="2.5" ry="3" transform="rotate(-15 4.5 10)"/>
            <path d="M12 9C8.5 9 6 12 6 15.5C6 18.5 8 21 12 21C16 21 18 18.5 18 15.5C18 12 15.5 9 12 9Z"/>
          </svg>
          WasPetInsuranceWorthIt.com
        </span>
        <nav class="flex flex-wrap gap-4">
          <a href="/about" class="hover:text-gray-800">About &amp; Methodology</a>
          <a href="/privacy" class="hover:text-gray-800">Privacy Policy</a>
          <span><!--email_off-->contact@waspetinsuranceworthit.com<!--/email_off--></span>
        </nav>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
    </script>
  </body>
</html>
