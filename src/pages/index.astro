---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Was Pet Insurance Worth It? Calculator"
  description="Find out honestly whether pet insurance would have been worth it for your specific pet. Enter your pet's history and get a real answer."
>
  <h1 class="text-3xl font-bold mb-4">Was Pet Insurance Worth It? Calculator</h1>
  <p class="text-gray-600 text-lg">
    Enter your pet's details, premiums paid, and vet bills to find out whether pet insurance
    would have been worth it for your specific situation. Honest math, no sales pitch.
  </p>
</BaseLayout>
