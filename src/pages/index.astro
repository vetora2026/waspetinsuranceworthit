---
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculator from '../components/Calculator';
---

<BaseLayout
  title="Was Pet Insurance Worth It? — Honest Calculator"
  description="Find out whether pet insurance was worth it for your specific pet. Uses data from 50,000 real pets and 210,000 claims. No sales pitch — just honest math."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Pet Insurance Worth It Calculator",
      "url": "https://waspetinsuranceworthit.com/",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Any",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "Find out whether pet insurance was worth it for your specific pet. Uses real claim data from 50,000 pets and 210,000 claims."
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How accurate is this calculator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It's a retrospective estimate, not a quote. We use industry-average premiums from NAPHIA and adjust for breed and age. Actual premiums vary by carrier, location, and your pet's health history."
          }
        },
        {
          "@type": "Question",
          "name": "Why does it sometimes say insurance wasn't worth it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Because for many pets, it isn't. The industry-wide loss ratio of 72% means the average policyholder gets back less than they pay in. Most pet insurance calculators are built by insurance companies or affiliate marketers. This tool isn't."
          }
        },
        {
          "@type": "Question",
          "name": "What policy assumptions do you use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "$500 annual deductible, 80% reimbursement rate, $15,000 annual limit, no wellness rider. These are the most common standard terms."
          }
        },
        {
          "@type": "Question",
          "name": "Where does the data come from?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Primary dataset: 50,000 pets, 210,235 claims (2018-2020). Industry baselines from the NAPHIA 2024 State of the Industry Report."
          }
        },
        {
          "@type": "Question",
          "name": "Should I get pet insurance?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on your financial situation and your pet's breed risk profile. Insurance makes the most sense if you can't absorb a $5,000-$10,000 emergency bill out of pocket, your breed has known high-cost conditions, and your pet is young enough to get a reasonable premium."
          }
        }
      ]
    })} />
  </Fragment>
  <!-- Hero -->
  <section class="mb-10">
    <div class="flex flex-col sm:flex-row gap-6 items-center mb-6">
      <!-- Illustration: above on mobile, right on desktop -->
      <div class="order-first sm:order-last flex-shrink-0">
        <svg width="200" height="160" viewBox="0 0 200 160" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <!-- Dog (teal, left side) -->
          <circle cx="65" cy="50" r="22" stroke="#1B6B6D" stroke-width="2.5"/>
          <!-- Floppy ear -->
          <path d="M46 40 Q35 32 38 52 Q40 64 53 66" stroke="#1B6B6D" stroke-width="2.5" stroke-linecap="round"/>
          <!-- Eye -->
          <circle cx="58" cy="46" r="2.5" fill="#1B6B6D"/>
          <!-- Nose -->
          <ellipse cx="74" cy="57" rx="4" ry="2.5" fill="#1B6B6D"/>
          <!-- Body -->
          <ellipse cx="65" cy="108" rx="24" ry="30" stroke="#1B6B6D" stroke-width="2.5"/>
          <!-- Tail -->
          <path d="M42 100 Q26 88 30 72" stroke="#1B6B6D" stroke-width="2.5" stroke-linecap="round"/>
          <!-- Front legs -->
          <line x1="53" y1="134" x2="53" y2="155" stroke="#1B6B6D" stroke-width="2.5" stroke-linecap="round"/>
          <line x1="70" y1="134" x2="70" y2="155" stroke="#1B6B6D" stroke-width="2.5" stroke-linecap="round"/>

          <!-- Cat (amber, right side) -->
          <circle cx="138" cy="50" r="20" stroke="#D4943A" stroke-width="2.5"/>
          <!-- Ears -->
          <path d="M125 38 L120 24 L135 38" stroke="#D4943A" stroke-width="2.5" stroke-linejoin="round"/>
          <path d="M151 38 L156 24 L141 38" stroke="#D4943A" stroke-width="2.5" stroke-linejoin="round"/>
          <!-- Eye -->
          <circle cx="144" cy="47" r="2.5" fill="#D4943A"/>
          <!-- Whiskers -->
          <line x1="120" y1="53" x2="131" y2="56" stroke="#D4943A" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="120" y1="59" x2="131" y2="59" stroke="#D4943A" stroke-width="1.5" stroke-linecap="round"/>
          <!-- Body -->
          <ellipse cx="138" cy="108" rx="22" ry="28" stroke="#D4943A" stroke-width="2.5"/>
          <!-- Tail -->
          <path d="M160 115 Q178 98 172 78 Q167 63 160 72" stroke="#D4943A" stroke-width="2.5" stroke-linecap="round"/>
          <!-- Front legs -->
          <line x1="127" y1="132" x2="127" y2="153" stroke="#D4943A" stroke-width="2.5" stroke-linecap="round"/>
          <line x1="144" y1="132" x2="144" y2="153" stroke="#D4943A" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </div>
      <!-- Text -->
      <div class="flex-1 order-last sm:order-first">
        <h1 class="text-3xl sm:text-4xl font-bold mb-3 leading-tight" style="color:#1A1A1A;">
          Was Pet Insurance Worth It?
        </h1>
        <p class="text-gray-600 text-base leading-relaxed">
          Whether insurance made sense for <em>your</em> pet depends on breed, age, and what actually
          happened at the vet. This calculator uses data from 50,000 real pets and 210,000 claims to
          show you the math.
        </p>
      </div>
    </div>

    <!-- PCP Framework: two data points, no editorializing -->
    <div class="grid sm:grid-cols-2 gap-4 mb-6">
      <div class="rounded-xl border border-gray-200 bg-white p-4">
        <p class="text-3xl font-bold" style="color:#1B6B6D;">$749<span class="text-lg font-normal text-gray-500">/yr</span></p>
        <p class="text-sm text-gray-600 mt-1">Average annual premium for dog owners (accident &amp; illness coverage)</p>
        <p class="text-xs text-gray-400 mt-1">NAPHIA 2024</p>
      </div>
      <div class="rounded-xl border border-gray-200 bg-white p-4">
        <p class="text-3xl font-bold" style="color:#D4943A;">72¢</p>
        <p class="text-sm text-gray-600 mt-1">Paid back in claims for every $1.00 collected in premiums, industry-wide</p>
        <p class="text-xs text-gray-400 mt-1">NAPHIA 2024 loss ratio</p>
      </div>
    </div>

  </section>

  <!-- Calculator -->
  <Calculator client:load />

  <!-- FAQ -->
  <section class="mt-16 space-y-3">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Frequently Asked Questions</h2>

    {[
      {
        q: "How accurate is this calculator?",
        a: "It's a retrospective estimate, not a quote. We use industry-average premiums from NAPHIA and adjust for breed and age. Actual premiums vary by carrier, location, and your pet's health history. Treat the result as a directional answer, not an exact figure.",
      },
      {
        q: "Why does it sometimes say insurance wasn't worth it?",
        a: "Because for many pets, the math doesn't justify the cost. The industry-wide loss ratio of 72% means insurers pay back 72 cents per dollar collected — that 28% margin covers overhead, admin, and profit, the same way all insurance works. The average dog owner nets about –$210/yr: a modest cost for protection against catastrophic bills. A few policyholders file enormous claims and come out far ahead. Most pet insurance calculators are built by insurance companies or affiliate marketers — they're designed to sell you a policy. This tool isn't.",
      },
      {
        q: "What policy assumptions do you use?",
        a: "$500 annual deductible, 80% reimbursement rate, $15,000 annual limit, no wellness rider. These are the most common standard terms. Routine and wellness care is excluded from our calculations — almost no accident-and-illness policies cover it.",
      },
      {
        q: "Where does the data come from?",
        a: "Primary dataset: 50,000 pets, 210,235 claims (2018–2020), publicly available research dataset from stevenrhart/predicting-claims. Industry baselines from the NAPHIA 2024 State of the Industry Report.",
      },
    ].map((item) => (
      <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
        <summary class="flex justify-between items-center px-5 py-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50 transition-colors list-none">
          {item.q}
          <svg class="w-4 h-4 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="px-5 pb-4 text-sm text-gray-600 leading-relaxed border-t border-gray-100 pt-3">
          {item.a}
        </div>
      </details>
    ))}

    <!-- Should I get pet insurance — with cross-links, rendered separately -->
    <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
      <summary class="flex justify-between items-center px-5 py-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50 transition-colors list-none">
        Should I get pet insurance?
        <svg class="w-4 h-4 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="px-5 pb-4 text-sm text-gray-600 leading-relaxed border-t border-gray-100 pt-3">
        That depends on your financial situation and your pet's breed risk profile. Insurance makes the most sense if: (1) you can't absorb a $5,000–$10,000 emergency bill out of pocket, (2) <a href="/expensive-breeds/" class="underline hover:text-gray-900" style="color:#1B6B6D;">your breed has known high-cost conditions</a>, and (3) your pet is young enough to get a reasonable premium. If you have a cat, <a href="/cats/" class="underline hover:text-gray-900" style="color:#1B6B6D;">the math works a bit differently for cats</a>. For older pets or financially resilient owners with low-risk breeds, self-insuring is often the better math.
      </div>
    </details>
  </section>

  <!-- Related Articles -->
  <section class="mt-14">
    <h2 class="text-xl font-semibold text-gray-900 mb-5">Related Articles</h2>
    <div class="grid sm:grid-cols-2 gap-4">
      <a href="/how-much-does-pet-insurance-cost/" class="block rounded-xl border border-gray-200 bg-white p-4 hover:border-gray-300 transition-colors group">
        <h3 class="font-semibold text-sm mb-1 group-hover:underline" style="color:#1B6B6D;">How Much Does Pet Insurance Cost Per Month?</h3>
        <p class="text-xs text-gray-500 leading-relaxed">Full premium reference by pet type, breed, deductible, and the industry loss ratio in context.</p>
      </a>
      <a href="/pet-insurance-vs-savings-account/" class="block rounded-xl border border-gray-200 bg-white p-4 hover:border-gray-300 transition-colors group">
        <h3 class="font-semibold text-sm mb-1 group-hover:underline" style="color:#1B6B6D;">Pet Insurance vs. Savings Account</h3>
        <p class="text-xs text-gray-500 leading-relaxed">The 10-year math on $50/month in premiums vs. $50/month in a dedicated savings fund.</p>
      </a>
      <a href="/what-does-pet-insurance-not-cover/" class="block rounded-xl border border-gray-200 bg-white p-4 hover:border-gray-300 transition-colors group">
        <h3 class="font-semibold text-sm mb-1 group-hover:underline" style="color:#1B6B6D;">What Does Pet Insurance Not Cover?</h3>
        <p class="text-xs text-gray-500 leading-relaxed">Full exclusion reference: pre-existing conditions, waiting periods, and routine care.</p>
      </a>
      <a href="/is-pet-insurance-worth-it/" class="block rounded-xl border border-gray-200 bg-white p-4 hover:border-gray-300 transition-colors group">
        <h3 class="font-semibold text-sm mb-1 group-hover:underline" style="color:#1B6B6D;">Is Pet Insurance Worth It?</h3>
        <p class="text-xs text-gray-500 leading-relaxed">The 72% payout rate: what it means, when insurance returns more than it costs, and when it doesn't.</p>
      </a>
    </div>
    <div class="mt-3 text-right">
      <a href="/articles" class="inline-block py-3 text-sm font-medium hover:underline" style="color:#1B6B6D;">View all articles →</a>
    </div>
  </section>

  <div class="mt-8 text-center">
    <a href="/about" class="inline-block py-3 text-sm font-medium hover:underline" style="color:#1B6B6D;">
      Read our full methodology →
    </a>
  </div>
</BaseLayout>
